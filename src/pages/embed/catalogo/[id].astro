---
// An installation and nothing else, for iframes on other people's pages. Its
// data source comes from the query string, as on its page.
import InstallationPlayer from '@/components/InstallationPlayer.astro';
import { t } from '@/i18n';
import { getCatalog } from '@/site/catalog';
import { href } from '@/site/url';

export async function getStaticPaths() {
  const catalog = await getCatalog();
  return catalog.models.filter((model) => catalog.draws(model)).map((model) => ({ params: { id: model.id } }));
}

const { id } = Astro.params;
const catalog = await getCatalog();
const model = catalog.model(id!);
const installation = catalog.installation(model);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{model.data.name} · {t('site.name')}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(href(`catalogo/${id}/`), Astro.site)} />
    <style define:vars={{ ratio: installation.width / installation.height }}>
      html,
      body {
        height: 100%;
        margin: 0;
        background: transparent;
      }
      body {
        display: grid;
        place-items: center;
        overflow: hidden;
      }
      :global(.playground) {
        margin: 0;
        width: min(100vw, calc(100vh * var(--ratio)));
      }
      :global(.stage) {
        padding: 0;
        border: 0;
        background: transparent;
      }
      :global(.wall) {
        max-width: none;
      }
    </style>
  </head>
  <body>
    <InstallationPlayer id={id!} title={model.data.name} installation={installation} bare />
  </body>
</html>
