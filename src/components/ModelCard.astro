---
import { Image } from 'astro:assets';
import PlaceholderArt from './PlaceholderArt.astro';
import { t } from '@/i18n';
import { yearsLabel } from '@/lib/catalog';
import { getCatalog, type Model } from '@/site/catalog';
import { hasPoster, posterHref } from '@/site/poster';
import { href } from '@/site/url';

interface Props {
  model: Model;
  /** Heading level of the card title, to fit the page outline. */
  level?: 2 | 3 | 4;
}

const { model, level = 3 } = Astro.props;
const catalog = await getCatalog();
const facts = catalog.facts(model);
const cover = catalog.cover(model);
// An entry with a replica is pictured by the replica itself, drawn at build
// time: sharper than any period photograph, and it is what the card leads to.
const poster = hasPoster(model) ? await posterHref(model) : undefined;
const Heading = `h${level}` as 'h3';
const years = yearsLabel(facts.years, facts.status);
const meta = [years, facts.stage === 'stub' ? t('catalog.stage.stub') : ''].filter(Boolean).join(' · ');
// Read by the filter on the catalog page: one data attribute per facet.
const data = Object.fromEntries(Object.entries(catalog.facetData(model)).map(([key, value]) => [`data-f-${key}`, value]));
const search = [facts.name, ...model.data.alsoKnownAs, facts.summary].join(' ');
---

<li class="card" data-model={model.id} data-search={search} {...data}>
  <div class:list={['card-media', { 'is-replica': poster }]}>
    {
      poster ? (
        <img src={poster} alt="" loading="lazy" decoding="async" />
      ) : cover ? (
        <Image src={cover.src} alt="" widths={[320, 640]} sizes="(min-width: 40rem) 20rem, 100vw" width={640} loading="lazy" />
      ) : (
        <PlaceholderArt seed={model.id} />
      )
    }
  </div>
  <div class="card-body">
    <Heading class="card-title"><a href={href(`catalogo/${model.id}/`)}>{facts.name}</a></Heading>
    <p class="card-text">{facts.summary}</p>
    {meta && <p class="card-meta">{meta}</p>}
    <ul class="badges">
      <li>
        <span class="badge">{t(`catalog.kind.${facts.kind}`)}</span>
      </li>
      {
        facts.hasReplica && (
          <li>
            <span class="badge is-dot">{t('catalog.replica.si')}</span>
          </li>
        )
      }
    </ul>
  </div>
</li>

<style>
  /* The whole sign, on the same ground as the stage of its page, rather than a crop. */
  .card-media.is-replica {
    position: relative;
    background: var(--stage);
    border-bottom: 1px solid var(--line);
  }

  .card-meta {
    margin: 0;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /*
   * Pinned to the 16:9 box: as a grid item, a height of 100% falls back to
   * the drawing's own proportions, and a tall sign (a clock, a vertical
   * indicator) overflowed the box and lost its bottom to the crop.
   */
  .card-media.is-replica img {
    position: absolute;
    inset: 0;
    object-fit: contain;
    padding: 7%;
  }
</style>
