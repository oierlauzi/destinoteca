---
// The site's name, spelled in flip-dots with the font of the first sign in the catalog.
import { t } from '@/i18n';
import { wordmark } from '@/site/wordmark';

const { width, height, dots } = wordmark();
---

<svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={t('site.name')} set:html={dots} />
