---
// The list of every manufacturer, operator, technology or family, with how
// many models each has. Families are shown as cards with a picture.
import FamilyCard from '@/components/FamilyCard.astro';
import { t } from '@/i18n';
import Base from '@/layouts/Base.astro';
import type { CollectionName } from '@/lib/catalog';
import { counted, countryName, getCatalog, type Family, type Manufacturer, type Operator } from '@/site/catalog';
import { ENTITY_PAGES } from '@/site/entities';
import { href } from '@/site/url';

interface Props {
  collection: CollectionName;
  locale: string;
}

const { collection } = Astro.props;
const catalog = await getCatalog();
const page = ENTITY_PAGES[collection];
/** A few key facts under each name, rather than the summary its own page leads with. */
function keyFacts(entry: ReturnType<typeof catalog.entities>[number]): string {
  if (collection === 'manufacturers') {
    const data = (entry as Manufacturer).data;
    return [data.city, data.country && countryName(data.country)].filter(Boolean).join(', ');
  }
  if (collection === 'operators') {
    const data = (entry as Operator).data;
    return [data.parent && catalog.operator(data.parent.id).data.name, data.country && countryName(data.country)].filter(Boolean).join(' · ');
  }
  return 'alsoKnownAs' in entry.data ? entry.data.alsoKnownAs.slice(0, 3).join(' · ') : '';
}
const entries = catalog.entities(collection).map((entry) => {
  return { entry, facts: keyFacts(entry), count: counted('catalog.count.models', catalog.modelsWith(page.facet, entry.id).length) };
});
---

<Base title={t(`${page.strings}.title`)} description={t(`${page.strings}.lead`)}>
  <div class="container page">
    <h1>{t(`${page.strings}.title`)}</h1>
    <p class="lead">{t(`${page.strings}.lead`)}</p>
    <ul class="card-grid entities">
      {
        collection === 'families' && entries.map(({ entry }) => <FamilyCard family={entry as Family} level={2} />)
      }
      {
        collection !== 'families' && entries.map(({ entry, facts, count }) => (
          <li class="card">
            <div class="card-body">
              <h2 class="card-title">
                <a href={href(`${page.segment}/${entry.id}/`)}>{entry.data.name}</a>
              </h2>
              {facts && <p class="card-text">{facts}</p>}
              <p class="card-meta muted">{count}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .entities {
    margin-top: 24px;
  }

  .entities .card-body {
    height: 100%;
  }

  .entities .card-meta {
    margin: auto 0 0;
    font-size: 0.85rem;
  }
</style>
