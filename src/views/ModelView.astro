---
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import Infobox from '@/components/Infobox.astro';
import InstallationPlayer from '@/components/InstallationPlayer.astro';
import ModelGrid from '@/components/ModelGrid.astro';
import PhotoGallery from '@/components/PhotoGallery.astro';
import References from '@/components/References.astro';
import ReplicaPlayground from '@/components/ReplicaPlayground.astro';
import { t } from '@/i18n';
import Base from '@/layouts/Base.astro';
import { inlineMarkdown } from '@/lib/catalog';
import { getCatalog } from '@/site/catalog';
import { href } from '@/site/url';

interface Props {
  id: string;
  locale: string;
}

const { id } = Astro.props;
const catalog = await getCatalog();
const model = catalog.model(id);
const data = model.data;
const facts = catalog.facts(model);
const { Content } = await render(model);

const photos = catalog.photos(model);
const cover = catalog.cover(model);
const social = cover ? (await getImage({ src: cover.src, width: Math.min(cover.src.width, 1200) })).src : undefined;
// One list per family it belongs to, each without this entry.
const siblings = facts.families
  .map((id) => ({ family: catalog.family(id), models: catalog.modelsWith('familia', id).filter((other) => other.id !== model.id) }))
  .filter(({ models }) => models.length > 0);
const elements = catalog.elementsOf(model);
const partOf = catalog.installationsWith(model);

/** "1996–2026", "desde 1996", "hasta 2026": whatever is known of a period. */
function span(from?: number, to?: number): string {
  if (from !== undefined && to !== undefined) return from === to ? String(from) : `${from}–${to}`;
  if (from !== undefined) return t('catalog.model.locations.since', { year: from });
  if (to !== undefined) return t('catalog.model.locations.until', { year: to });
  return '';
}

/** "C-4 · hasta 2026 · Retirado": what is known of a location, as one line of text. */
const locationFacts = (location: { line?: string; years: string; status: string }): string =>
  [location.line, location.years, location.status !== 'unknown' ? t(`catalog.status.${location.status}`) : '']
    .filter(Boolean)
    .join(' · ');

const locations = data.locations.map((location) => {
  const site = location.site ? catalog.site(location.site.id) : undefined;
  return {
    place: site?.data.name ?? location.placeName ?? location.fleet ?? '',
    town: site && site.data.town !== site.data.name ? site.data.town : undefined,
    line: location.line,
    years: span(location.from, location.to),
    status: location.status,
    note: location.note,
  };
});
---

<Base title={data.name} description={data.summary} source={`src/content/models/${model.id}/index.md`} image={social}>
  <div class="container page">
    <header class="model-header">
      <p class="eyebrow">{t(`catalog.kind.${data.kind}`)}</p>
      <h1>{data.name}</h1>
      <p class="lead">{data.summary}</p>
      <ul class="badges">
        {
          facts.technologies.map((id) => (
            <li>
              <a class="badge" href={href(`tecnologias/${id}/`)}>
                {catalog.technology(id).data.name}
              </a>
            </li>
          ))
        }
        {
          facts.manufacturers.map((manufacturer) => (
            <li>
              <a class="badge" href={href(`fabricantes/${manufacturer}/`)}>
                {catalog.manufacturer(manufacturer).data.name}
              </a>
            </li>
          ))
        }
      </ul>
    </header>

    {
      data.stage === 'stub' && (
        <p class="stub-note">
          {t('catalog.model.stub')} <a href={href('contribuir/')}>{t('catalog.model.stubLink')}</a>.
        </p>
      )
    }

    {
      data.replica && (
        <section class="replica" aria-labelledby="replica-title">
          <h2 id="replica-title" class="visually-hidden">
            {t('catalog.model.replica')}
          </h2>
          <ReplicaPlayground replicaId={data.replica.id} params={data.replica.params} />
        </section>
      )
    }

    {
      data.installation && (
        <section class="replica" aria-labelledby="replica-title">
          <h2 id="replica-title" class="visually-hidden">
            {t('catalog.model.installation')}
          </h2>
          <InstallationPlayer id={model.id} title={data.name} installation={catalog.installation(model)} />
        </section>
      )
    }

    {
      elements.length > 0 && (
        <section aria-labelledby="elementos">
          <h2 id="elementos">{t('catalog.model.elements')}</h2>
          <p class="muted">{t('catalog.model.elements.help')}</p>
          <ModelGrid models={elements} />
        </section>
      )
    }

    <div class="model-body">
      <Infobox model={model} />
      <article class="prose">
        <Content />
      </article>
    </div>

    {
      locations.length > 0 && (
        <section aria-labelledby="ubicaciones">
          <h2 id="ubicaciones">{t('catalog.model.locations')}</h2>
          <ul class="locations">
            {locations.map((location) => (
              <li>
                <p class="where">
                  <strong>{location.place}</strong>
                  {location.town && <span class="muted"> · {location.town}</span>}
                </p>
                {locationFacts(location) && <p class="facts muted">{locationFacts(location)}</p>}
                {location.note && <p class="note muted" set:html={inlineMarkdown(location.note)} />}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      data.variants.length > 0 && (
        <section aria-labelledby="variantes">
          <h2 id="variantes">{t('catalog.model.variants')}</h2>
          <dl class="variants">
            {data.variants.map((variant) => (
              <div id={`variante-${variant.id}`}>
                <dt>{variant.name}</dt>
                {variant.description && <dd set:html={inlineMarkdown(variant.description)} />}
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      photos.length > 0 && (
        <section aria-labelledby="fotografias">
          <h2 id="fotografias">{t('catalog.model.photos')}</h2>
          <PhotoGallery photos={photos} />
        </section>
      )
    }

    {
      data.references.length > 0 && (
        <section aria-labelledby="fuentes">
          <h2 id="fuentes">{t('catalog.model.references')}</h2>
          <References references={data.references} />
        </section>
      )
    }

    {
      partOf.length > 0 && (
        <section aria-labelledby="composiciones">
          <h2 id="composiciones">{t('catalog.model.partOf')}</h2>
          <ModelGrid models={partOf} />
        </section>
      )
    }

    {
      siblings.map(({ family, models }) => (
        <section aria-labelledby={`familia-${family.id}`}>
          <h2 id={`familia-${family.id}`}>
            {t('catalog.model.sameFamily')} <a href={href(`familias/${family.id}/`)}>{family.data.name}</a>
          </h2>
          <ModelGrid models={models} />
        </section>
      ))
    }
  </div>
</Base>

<style>
  .model-header {
    margin-bottom: 24px;
  }

  .model-header .badges {
    margin-top: 12px;
  }

  .stub-note {
    background: var(--surface);
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    padding: 10px 14px;
    max-width: var(--measure);
  }

  .replica {
    margin-block: 8px 32px;
  }

  /* Facts first on a phone, beside the article on a wide screen. */
  .model-body {
    display: grid;
    gap: 24px 40px;
    align-items: start;
  }

  @media (min-width: 62rem) {
    .model-body {
      grid-template-columns: minmax(0, var(--measure)) minmax(17rem, 1fr);
    }

    .model-body :global(.infobox) {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: 16px;
    }

    .model-body .prose {
      grid-column: 1;
      grid-row: 1;
    }
  }

  .locations {
    list-style: none;
    padding: 0;
    margin: 0 0 1em;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 12px;
  }

  .locations > li {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 10px 14px 12px;
    display: grid;
    gap: 6px;
    align-content: start;
  }

  .locations p {
    margin: 0;
  }

  .locations .facts {
    margin: 0;
    font-size: 0.9rem;
  }

  .locations .note {
    font-size: 0.9rem;
  }

  .variants {
    display: grid;
    gap: 12px;
    max-width: var(--measure);
  }

  .variants dt {
    font-weight: 600;
  }

  .variants dd {
    margin: 0;
    color: var(--muted);
  }
</style>
